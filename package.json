{
  "name": "chekkpoint",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm services:up && vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed-public": "node --env-file-if-exists=.env scripts/seed-public.mjs",
    "test": "node --test src/public/__tests__/public.shared.test.ts",
    "auth:make-admin": "node --env-file-if-exists=.env scripts/make-admin.mjs",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v && docker compose up -d --wait",
    "services:logs": "docker compose logs -f"
  },
